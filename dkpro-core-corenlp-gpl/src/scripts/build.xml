<project basedir="../.." default="separate-jars">
  <import>
        <url url="https://raw.githubusercontent.com/dkpro/resource-packager/0.8.0/ant-macros.xml"/>
  </import>
  
  <!-- 
    - Upstream versions - meta data versions are maintained per model below 
    -->
  <!-- http://nlp.stanford.edu/software/corenlp.shtml -->
  <!-- The models are obtained from the CoreNLP model jars published on Hugging Face
    - (https://huggingface.co/stanfordnlp). The 2018-10-05 jars previously obtained from
    - nlp.stanford.edu are no longer available. The Arabic and Chinese models we extract
    - are byte-identical in the 4.6.0 jars, so their model versions are unchanged.
    - The downloads are pinned to the Hugging Face commits that the tag v4.6.0 points to.
    -->
  <property name="core.arabic.hf.revision" value="745ce5040f104f96f3c72c71e308d45cc02ae5cf"/>
  <property name="core.chinese.hf.revision" value="6d33de36a65b4d2cdc93b0d12f00508e7c197d0a"/>
  <property name="core.english.hf.revision" value="9b1230676f0e263ab31d22a46a227c60edf56b76"/>
  <property name="core.french.hf.revision" value="b49f133cb5b415220002ca3ea830ccadf55e1e89"/>
  <property name="core.german.hf.revision" value="220006fcc2d0eab53f94633a663c3b13dc97f6f2"/>

  <!-- 
    - Output package configuration
    -->
  <property name="outputPackage" value="de/tudarmstadt/ukp/dkpro/core/corenlp/lib"/>

  <target name="local-maven">
    <property name="install-artifact-mode" value="local"/>
    <antcall target="separate-jars"/>
  </target>

  <target name="remote-maven">
    <property name="install-artifact-mode" value="remote"/>
    <antcall target="separate-jars"/>
  </target>

  <target name="separate-jars" depends="ar,de,en,fr,zh">
    <antcall target="jar-notice"/>
  </target>

  <target name="newmodels">
    <property name="install-artifact-mode" value="remote"/>
    
    <antcall target="depparser-fr-ud"/>
  </target>

  <target name="de">
    <antcall target="depparser-de-ud"/>
    <antcall target="tagger-de-ud"/>
  </target>

  <target name="tagger-de-ud">
    <!-- POS tagger models are looked up by CoreNlpPosTagger under the stanfordnlp package, so
      - the actual target is called with a different outputPackage. -->
    <antcall target="-tagger-de-ud">
      <param name="outputPackage" value="de/tudarmstadt/ukp/dkpro/core/stanfordnlp/lib"/>
    </antcall>
  </target>

  <target name="-tagger-de-ud" depends="download-de">
    <!-- FILE: german-ud.tagger (from the CoreNLP models jars on Maven Central / Hugging Face) - - - -
      - 2016-12-13 | 2020-04-20 | bf5af79f6927580168636b8c477432aa (CoreNLP 3.7.0 - 3.9.2)
      - 2020-04-20 | 2024-01-31 | 8345e8a10e5edb8132a32a1e4b6d46bf (CoreNLP 4.0.0 - 4.5.5)
      - 2024-01-31 | 2024-10-17 | 0597541d884d2b2ee31ed1e9bfcb53f1 (CoreNLP 4.5.6 - 4.5.7)
      - 2024-10-17 |   now      | 4333f660e39bf3f9907ec06fa88f20f5 (CoreNLP 4.5.8 - 4.6.0)
      -->
    <mkdir dir="target/download/tmp"/>
    <unzip src="target/download/de/de-models.zip" dest="target/download/tmp">
      <patternset>
        <include name="edu/stanford/nlp/models/pos-tagger/german-ud.tagger"/>
      </patternset>
    </unzip>
    <install-stub-and-upstream-file 
        file="target/download/tmp/edu/stanford/nlp/models/pos-tagger/german-ud.tagger" 
        md5="4333f660e39bf3f9907ec06fa88f20f5"
        groupId="de.tudarmstadt.ukp.dkpro.core" 
        artifactIdBase="de.tudarmstadt.ukp.dkpro.core.stanfordnlp"
        upstreamVersion="20241017"
        metaDataVersion="0"
        tool="tagger" 
        language="de" 
        variant="ud" 
        extension="tagger">
      <metadata>
        <entry key="pos.tagset" value="ud2"/>
        <entry key="ptb3Escaping" value="false"/>
      </metadata>
    </install-stub-and-upstream-file>
    <deltree dir="target/download/tmp"/>
  </target>

